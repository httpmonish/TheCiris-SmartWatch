# ==============================================================================
# CIRIS WEARABLE PRODUCTION PLATFORM CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Relational Database
DATABASE_PATH=./database/ciris_platform.db

# Machine Learning & Pipelines
MODEL_STORAGE_PATH=./ml_pipeline/models
DATASET_STORAGE_PATH=./ml_pipeline/data
PYTHON_EXECUTABLE=python

# Storage & Uploads
UPLOAD_DIRECTORY=./web_app/uploads
MAX_UPLOAD_SIZE_BYTES=104857600

# AI Diagnostic Engine (Optional OpenAI Key for GPT-4o Chat Companion)
OPENAI_API_KEY=
